# Penaven environment template. Copy to .env (the Prisma CLI reads .env; Next.js
# also reads .env.local). Placeholder values only. Never commit real keys.
# Production startup checks: src/lib/env/production.ts

# --- Required ---------------------------------------------------------------
# Local: `npm run db:local` (PGlite on 5433) or any Postgres.
# Production: Neon pooled URL with sslmode=require.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"
APP_URL="http://localhost:3000"

# --- Auth (Clerk) — required in production unless PUBLIC_DEMO_MODE is on ------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your-clerk-publishable-key"
CLERK_SECRET_KEY="sk_test_your-clerk-secret-key"
# Read by verifyWebhook() in /api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET="whsec_your-webhook-secret"
# Read by the Clerk SDK
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Signs widget visitor sessions. Production refuses to start without it
# (Clerk mode). Use a long random string.
WIDGET_VISITOR_SECRET="replace-with-a-long-random-string"

# --- Demo / auth bypass — local or portfolio demo only, never a real tenant ----
# PUBLIC_DEMO_MODE needs both bypass flags, OPENROUTER_API_KEY and DEMO_SEED_SECRET.
# PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_PUBLIC_DEMO_MODE=true
# AUTH_BYPASS=true
# NEXT_PUBLIC_AUTH_BYPASS=true
# Protects POST /api/demo/seed (header x-demo-seed-secret). Required for the seed in production.
# DEMO_SEED_SECRET="replace-with-a-random-string"
# Demo workspace used by the bypass and the seed (these are the defaults)
# DEMO_ORGANIZATION_SLUG="demo-company"
# DEMO_USER_EMAIL="admin@demo.com"
# Stable widget key for the demo and e2e tests
# DEMO_WIDGET_KEY="wk_test_e2e_demo_widget_key"
# CI / Playwright only: allows the bypass in a production build
# E2E_AUTH_BYPASS=true

# --- LLM --------------------------------------------------------------------
# openrouter (or free) = skip Gemini · gemini = Gemini first · auto = Gemini first, then OpenRouter (default)
AI_PROVIDER_PREFERENCE=openrouter

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
OPENROUTER_CHAT_MODEL="openrouter/free"
# Set to enable embeddings for retrieval; empty = keyword retrieval
OPENROUTER_EMBEDDING_MODEL=""
# Fallbacks: OPENAI_API_KEY is used when OPENROUTER_API_KEY is unset;
# AI_CHAT_MODEL is used when OPENROUTER_CHAT_MODEL is unset.
# OPENAI_API_KEY="sk-your-openai-key"
# AI_CHAT_MODEL="openrouter/free"

# Gemini: https://aistudio.google.com/apikey
# GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_CHAT_MODEL="gemini-3.5-flash"

# --- Hiring limits (defaults shown) -----------------------------------------
# MAX_UPLOAD_BYTES=5242880
# MAX_RESUME_TEXT_CHARS=12000
# HIRE_GRACE_MINUTES=10

# --- Optional infra ---------------------------------------------------------
# Rate limits shared across instances. Unset = per-instance, in memory.
# UPSTASH_REDIS_REST_URL="https://your-upstash-url"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Firebase Realtime Database evidence for agent runs
# FIREBASE_DATABASE_URL="https://your-project-default-rtdb.firebaseio.com"
# FIREBASE_RTDB_PATH="opsconcierge_agent_runs"

# Optional Cloud Run worker (cloud-run/ops-worker), used when RTDB is unset
# OPS_WORKER_URL="https://your-ops-worker.run.app"
