{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-e2e-two-clients/types/**/*.ts",
    ".next-e2e-two-clients/dev/types/**/*.ts",
    ".next-e2e-two-clients-clerk/types/**/*.ts",
    ".next-e2e-two-clients-clerk/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/types/validator.ts",
    ".next-e2e-two-clients/types/validator.ts",
    ".next-e2e-two-clients-clerk/types/validator.ts",
    ".worktrees",
    ".claude/worktrees"
  ]
}
